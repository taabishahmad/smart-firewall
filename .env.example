# -----------------------------------------------------------------------------
# Smart Firewall — example configuration.
# Copy this file to `.env` and adjust. Every value has a sensible default, so
# the app runs even with no .env at all. Load it with:  export $(cat .env | xargs)
# or use python-dotenv if you prefer.
# -----------------------------------------------------------------------------

# Flask session signing key. CHANGE THIS for anything beyond local testing.
SECRET_KEY=change-me-to-a-long-random-string

# Password given to the auto-created "admin" account on first launch.
ADMIN_PASSWORD=admin123

# ---- Enforcement: pfSense REST API (optional) -------------------------------
# Leave blank to use iptables (when run as root) or simulation (default).
PFSENSE_URL=
PFSENSE_API_KEY=
PFSENSE_API_SECRET=
PFSENSE_ALIAS=smartfw_block
PFSENSE_VERIFY_TLS=false

# ---- Email alerts (optional) ------------------------------------------------
# Leave SMTP_HOST blank to disable email; alerts are still shown in the UI and
# written to the activity log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=smartfw@example.com
MAIL_TO=admin@example.com
